# ─────────────────────────────────────────────────────
# RushData PORTAL — template de variables de entorno
# Copia este archivo a .env.local y llena los valores reales
# .env.local está en .gitignore (NO se sube al repo)
# ─────────────────────────────────────────────────────

# Supabase — Settings → API en el dashboard del proyecto
SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Frontend (Next.js) — mismas que arriba con prefijo NEXT_PUBLIC_*
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# ─── Fase 5: Resend (alertas por email) ───
# RESEND_API_KEY=re_xxxxxxxxxxxxx
